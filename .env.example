# Healthcare Knowledge Assistant - Environment Variables
# Copy this file to .env and fill in your API keys.
# NEVER commit the .env file to version control.

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Provide ONE of the following:

# Option A: OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Option B: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional LLM Settings ──────────────────────────────────────────────────────
# LLM_PROVIDER=openai          # or 'gemini' — auto-detected if unset
# OPENAI_MODEL=gpt-3.5-turbo   # or gpt-4, gpt-4o
# GEMINI_MODEL=gemini-1.5-flash

# ── App Settings ──────────────────────────────────────────────────────────────
# CHROMA_DB_PATH=data/chroma_db
# EMBEDDINGS_CACHE_PATH=data/embeddings
# DOCUMENT_REGISTRY_PATH=data/document_registry.json
# LOG_LEVEL=INFO
